                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "networkInterfaceID": {
            "type": "string"
          },
          "transitGatewayID": {
            "type": "string"
