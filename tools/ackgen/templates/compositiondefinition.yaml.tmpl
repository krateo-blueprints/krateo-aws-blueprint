apiVersion: core.krateo.io/v1alpha1
kind: CompositionDefinition
metadata:
  name: [[.ChartName]]
  namespace: [[.Namespace]]
spec:
  chart:
    # OCI artifact published by .github/workflows/release-tag.yaml.
    url: oci://ghcr.io/krateo-blueprints/charts/[[.ChartName]]
    version: "[[.ChartVersion]]"
    # If the GHCR package is private, provide pull credentials:
    # credentials:
    #   username: krateo
    #   passwordRef:
    #     key: token
    #     name: ghcr-credentials
    #     namespace: [[.Namespace]]
