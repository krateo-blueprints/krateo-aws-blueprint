{{- /*
Renders a native ACK [[.AckKind]] custom resource from the Composition spec.

The Composition spec (.Values) mirrors the ACK [[.AckKind]] spec, so it passes through verbatim.
`region` is Krateo-wiring (not part of the ACK spec) and becomes the standard ACK region
annotation. Generated by tools/ackgen.
*/ -}}
apiVersion: [[.Group]]/[[.AckVersion]]
kind: [[.AckKind]]
metadata:
  name: {{ .Release.Name }}
  namespace: {{ .Release.Namespace }}
  labels:
    {{- include "[[.ChartName]].labels" . | nindent 4 }}
  {{- with .Values.region }}
  annotations:
    services.k8s.aws/region: {{ . | quote }}
  {{- end }}
{{- $spec := omit .Values "region" }}
{{- if $spec }}
spec:
{{ toYaml $spec | indent 2 }}
{{- else }}
spec: {}
{{- end }}
